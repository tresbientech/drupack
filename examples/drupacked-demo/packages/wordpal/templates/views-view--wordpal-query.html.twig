{#
  A wordpal_query View converts the same way on every target and keeps this
  tag either way (see wordpal_display_builder's ListingWriter), so this
  template is shared. Only Canvas's writer fills `query`/`wordpal_content`,
  through its own wordpal:query runtime component; Display Builder's writer
  places the View through a plain `block` source instead, and
  display_builder_views' own preprocess hook already built `content` from
  the display's own sources.
#}
{% if content is defined %}
  {{ content }}
{% else %}
  {% embed 'wordpal:query' with query|merge({wordpal_content: wordpal_content}) only %}
    {% block content %}{{ wordpal_content }}{% endblock %}
  {% endembed %}
{% endif %}
