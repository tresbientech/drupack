{#
/**
 * @file
 * WordPress core/video.
 */
#}
<figure{{ attributes.addClass('wp-block-video').merge(wordpal_attributes('core/video', _context, false)) }}>
  {%- if src -%}
    <video{% if autoplay %} autoplay{% endif %}{% if controls %} controls{% endif %}{% if loop %} loop{% endif %}{% if muted %} muted{% endif %}{% if poster %} poster="{{ wordpal_url(poster) }}"{% endif %}{% if preload and preload != 'metadata' %} preload="{{ preload }}"{% endif %} src="{{ wordpal_url(src) }}"{% if width %} width="{{ width }}"{% endif %}{% if height %} height="{{ height }}"{% endif %}{% if width and height %} style="{{ wordpal_css_declarations({'aspect-ratio': width ~ ' / ' ~ height}) }}"{% endif %}{% if plays_inline %} playsinline{% endif %}></video>
  {%- endif -%}
  {%- if caption -%}<figcaption class="wp-element-caption">{{ wordpal_html(caption) }}</figcaption>{%- endif -%}
</figure>
