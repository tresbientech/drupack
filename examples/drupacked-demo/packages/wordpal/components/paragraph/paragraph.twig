{#
/**
 * @file
 * WordPress core/paragraph.
 */
#}
{% set classes = ['wp-block-paragraph', drop_cap and text_align not in ['center', 'right'] ? 'has-drop-cap'] %}
{% if direction %}{% set attributes = attributes.setAttribute('dir', direction) %}{% endif %}
<p{{ attributes.addClass(classes).merge(wordpal_attributes('core/paragraph', _context, false)) }}>{{ wordpal_html(content|default('')) }}</p>
{% if fit_text %}{{ attach_library('wordpal/interactivity.fit-text') }}{% endif %}
