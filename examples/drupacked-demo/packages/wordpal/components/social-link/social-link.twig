{#
/**
 * @file
 * WordPress core/social-link.
 *
 * The open_in_new_tab, show_labels and icon color props carry the parent
 * Social Icons block's context.
 */
#}
{% if url %}
  {% set service_data = wordpal_social_service(service ?: 'Icon') %}
  {% set href = url %}
  {% if '@' in url and ':' not in url and ' ' not in url %}
    {% set href = 'mailto:' ~ url %}
  {% elseif not (url matches '/^[a-z][a-z0-9+.-]*:/i') and not (url starts with '//') and not (url starts with '#') %}
    {% set href = 'https://' ~ url %}
  {% endif %}
  {% set styles = {} %}
  {% if icon_color_value %}
    {% set styles = styles|merge({'color': wordpal_css_value(icon_color_value)}) %}
  {% endif %}
  {% if icon_background_color_value %}
    {% set styles = styles|merge({'background-color': wordpal_css_value(icon_background_color_value)}) %}
  {% endif %}
  {% set classes = [
    'wp-social-link',
    'wp-social-link-' ~ service,
    'wp-block-social-link',
    icon_color ? 'has-' ~ icon_color ~ '-color',
    icon_background_color ? 'has-' ~ icon_background_color ~ '-background-color',
  ] %}
<li{{ attributes.addClass(classes).merge(wordpal_attributes('core/social-link', _context, false, styles)) }}><a href="{{ wordpal_url(href) }}" class="wp-block-social-link-anchor"{% if open_in_new_tab %} rel="{{ (rel ~ ' noopener nofollow')|trim }}" target="_blank"{% elseif rel %} rel="{{ rel|trim }}"{% endif %}>{{ service_data.icon }}<span class="wp-block-social-link-label{{ show_labels ? '' : ' screen-reader-text' }}">{{ label|trim ?: service_data.name }}</span></a></li>
{% endif %}
