{
	admin off
	auto_https off
	persist_config off
	# Windows PHP keys its opcache segment per user account, so a second server attaches to
	# the first one's segment, finds opcode handlers from a differently based image and aborts
	# before it binds. The cache id gives each Site data its own segment. Other platforms do
	# not register the directive and ignore it.
	frankenphp {
		php_ini "opcache.cache_id" "__DRUPACK_ID__"
	}
	order php_server before file_server
	log {
		output file "__DRUPACK_LOG_PATH__" {
			roll_size 100MiB
			roll_keep 10
		}
		format json
	}
}

http://:__DRUPACK_PORT__ {
	bind __DRUPACK_BIND__
	root * __DRUPACK_DOCROOT__
	encode zstd br gzip

	# Caddy sorts directives by kind, which puts a file route ahead of every
	# matcher that guards it. One route block keeps the written order instead, so
	# each guard is stated once and runs before the routes it protects.
	route {
		# The readiness probe runtime/watch/watch.go polls until this server answers. The
		# token names the Site data this server serves, and a caller without it gets 404,
		# so the route tells it nothing. Caddy answers it without reaching Drupal, which
		# keeps a cold start from rendering a page nobody reads.
		# Placed ahead of the protected-file matchers, which answer 403 for any dot path.
		@drupackIdentity {
			path /.drupack-id
			query id=__DRUPACK_ID__
		}
		respond @drupackIdentity 204
		@drupackIdentityOther path /.drupack-id
		respond @drupackIdentityOther 404

		import "__DRUPACK_GUARDS__"
		# Public files live in the files directory, Site data's "files" unless a start
		# names another, never under the application, which one release shares across
		# sites. The address stays root-relative, so it survives a restart on another port.
		route /sites/default/files/* {
			root * "__DRUPACK_FILES_DIR__"
			uri strip_prefix /sites/default/files
			@stored file
			file_server @stored
			# An image style derivative exists only once the site has generated
			# it. A request finding no file carries on to the site, under the
			# address the reader asked for, with its query.
			@absent not file
			rewrite @absent /sites/default/files{path}
		}
		php_server {
			root __DRUPACK_DOCROOT__
		}
	}
}
