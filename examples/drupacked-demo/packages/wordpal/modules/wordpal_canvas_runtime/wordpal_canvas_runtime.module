<?php

/**
 * @file
 * Views hooks for WordPal Canvas Runtime.
 */

declare(strict_types=1);

/**
 * Implements hook_views_data().
 */
function wordpal_canvas_runtime_views_data(): array {
  return [
    'views' => [
      'wordpal_pattern' => [
        'title' => t('WordPal Pattern'),
        'help' => t('Renders a converted Canvas Pattern: a query empty state or a listing Template.'),
        'area' => ['id' => 'wordpal_pattern'],
      ],
    ],
  ];
}
