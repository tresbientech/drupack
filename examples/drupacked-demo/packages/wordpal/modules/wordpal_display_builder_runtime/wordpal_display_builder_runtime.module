<?php

/**
 * @file
 * Runtime rendering hooks for converted WordPal Display Builder sites.
 */

declare(strict_types=1);

use Drupal\wordpal\Theme\ViewTags;

/**
 * Implements hook_views_data().
 */
function wordpal_display_builder_runtime_views_data(): array {
  return [
    'views' => [
      'wordpal_pattern_preset' => [
        'title' => t('WordPal pattern preset'),
        'help' => t('Renders a converted Display Builder pattern preset: a query empty state or a listing Template.'),
        'area' => ['id' => 'wordpal_pattern_preset'],
      ],
    ],
  ];
}

/**
 * Implements hook_theme().
 */
function wordpal_display_builder_runtime_theme(): array {
  return [
    'views_view__wordpal_display_builder' => ['base hook' => 'views_view'],
  ];
}

/**
 * Implements hook_theme_suggestions_alter().
 *
 * Display Builder registers views_view__<view>__<display> at runtime with no
 * base hook, so core runs only this generic alter for it. Its template wraps
 * the sources in the .view div that Views Ajax needs; WordPress prints the
 * Query block with no wrapper, so a converted View without Ajax drops it.
 */
function wordpal_display_builder_runtime_theme_suggestions_alter(array &$suggestions, array $variables, string $hook): void {
  if (!str_starts_with($hook, 'views_view__')) {
    return;
  }
  $view = $variables['view'];
  if (in_array($view->storage->get('tag'), [ViewTags::QUERY, ViewTags::TEMPLATE], TRUE) && !$view->ajaxEnabled()) {
    $suggestions[] = 'views_view__wordpal_display_builder';
  }
}
