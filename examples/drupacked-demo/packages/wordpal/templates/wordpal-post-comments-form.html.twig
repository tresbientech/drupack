{% if comment_form %}<div id="respond"{% if settings.padding_top or settings.padding_bottom %} style="{% if settings.padding_top %}padding-top:{{ wordpal_css_value(settings.padding_top) }};{% endif %}{% if settings.padding_bottom %}padding-bottom:{{ wordpal_css_value(settings.padding_bottom) }};{% endif %}"{% endif %} class="comment-respond wp-block-post-comments-form"><h3 id="reply-title" class="comment-reply-title">{{ 'Leave a Reply'|t }} <small><a rel="nofollow" id="cancel-comment-reply-link" href="#respond" style="display:none;">{{ 'Cancel reply'|t }}</a></small></h3>{{ comment_form }}</div>{% endif %}
