<?php

/**
 * @file
 * Theme hooks for WordPal runtime blocks.
 */

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Theme\ThemePreprocess;
use Drupal\views\Entity\View;
use Drupal\views\ViewEntityInterface;
use Drupal\views\ViewExecutable;
use Drupal\wordpal\Layout\LayoutRenderer;
use Drupal\wordpal\Listing\ListingRows;
use Drupal\wordpal\Listing\ListingSettings;
use Drupal\wordpal\Query\PostClasses;
use Drupal\wordpal\Query\QuerySettings;
use Drupal\wordpal\Theme\ViewTags;

/**
 * Implements hook_theme().
 */
function wordpal_theme(): array {
  return [
    'wordpal_comments' => [
      'variables' => [
        'settings' => [],
        'content' => [],
      ],
    ],
    'wordpal_comments_title' => ['variables' => ['node' => NULL, 'count' => 0, 'settings' => []]],
    'wordpal_comment_template' => ['variables' => ['comments' => []]],
    'wordpal_comment_avatar' => ['variables' => ['comment' => [], 'settings' => []]],
    'wordpal_comment_author_name' => ['variables' => ['comment' => [], 'settings' => []]],
    'wordpal_comment_date' => ['variables' => ['comment' => [], 'settings' => []]],
    'wordpal_comment_content' => ['variables' => ['comment' => [], 'settings' => []]],
    'wordpal_comments_pagination' => ['variables' => ['pager' => [], 'settings' => []]],
    'wordpal_comments_pagination_numbers' => ['variables' => ['pages' => []]],
    'wordpal_post_comments_form' => ['variables' => ['comment_form' => [], 'settings' => []]],
    'wordpal_comment_form' => [
      'render element' => 'form',
    ],
    'wordpal_textarea' => [
      'base hook' => 'textarea',
    ],
    'links__wordpal_comment' => [
      // No 'base hook': core/comment-reply-link and core/comment-edit-link's
      // own typography and color supports need a wrapper_attributes
      // variable the 'links' hook's own variable set has no room for.
      'variables' => [
        'links' => [],
        'attributes' => [],
        'heading' => NULL,
        'wrapper_attributes' => NULL,
      ],
      'template' => 'links--wordpal-comment',
    ],
    'wordpal_adjacent_post' => [
      'variables' => [
        'direction' => NULL,
        'label' => NULL,
        'show_title' => FALSE,
        'link_label' => FALSE,
        'arrow' => 'none',
        'supports' => [],
        'title' => NULL,
        'url' => NULL,
      ],
    ],
    'wordpal_site_title' => [
      'variables' => [
        'attributes' => [],
        'title' => NULL,
        'front_url' => '/',
        'level' => 1,
        'is_link' => TRUE,
        'link_target' => '_self',
        'current' => FALSE,
        'supports' => [],
      ],
    ],
    'wordpal_site_tagline' => [
      'variables' => [
        'attributes' => [],
        'tagline' => NULL,
        'level' => 0,
        'supports' => [],
      ],
    ],
    'wordpal_site_logo' => [
      'variables' => [
        'attributes' => [],
        'logo_url' => NULL,
        'alt' => '',
        'front_url' => '/',
        'width' => 0,
        'is_link' => TRUE,
        'link_target' => '_self',
        'supports' => [],
      ],
    ],
    'wordpal_navigation' => [
      'variables' => [
        'attributes' => [],
        'items' => [],
        'active_link' => NULL,
        'modal_id' => '',
        'overlay_menu' => 'mobile',
        'icon' => 'handle',
        'has_icon' => TRUE,
        'show_submenu_icon' => FALSE,
        'submenu_visibility' => 'hover',
        'page_list' => FALSE,
        'trailing' => [],
        'aria_label' => '',
        'list_aria_label' => '',
        'text_color' => '',
        'background_color' => '',
        'supports' => [],
        'overlay_background_color' => '',
        'custom_overlay_background_color' => '',
        'overlay_text_color' => '',
        'custom_overlay_text_color' => '',
      ],
    ],
    'wordpal_navigation_link' => [
      'variables' => [
        'title' => NULL,
        'url' => NULL,
        'css_class' => '',
      ],
    ],
    'wordpal_categories' => [
      'variables' => [
        'attributes' => [],
        'items' => [],
        'show_count' => FALSE,
        'taxonomy' => 'category',
        'display_as_dropdown' => FALSE,
        'dropdown_id' => '',
        'supports' => [],
      ],
    ],
    'wordpal_search' => [
      'variables' => [
        'attributes' => [],
        'input_id' => '',
        'action' => '',
        'parameter' => '',
        'value' => '',
        'width' => '',
        'settings' => [],
      ],
    ],
    'wordpal_post_author_biography' => [
      'variables' => [
        'attributes' => [],
        'biography' => [],
        'settings' => [],
      ],
    ],
    'wordpal_tag_cloud' => ['variables' => ['attributes' => [], 'tags' => [], 'settings' => []]],
    'wordpal_archives' => ['variables' => ['attributes' => [], 'months' => [], 'dropdown_id' => '', 'settings' => []]],
    'block__wordpal_runtime' => ['base hook' => 'block'],
    'block__views_block__wordpal_listing' => ['base hook' => 'block'],
    'views_view__wordpal_query' => ['base hook' => 'views_view'],
    'views_view__wordpal_template' => ['base hook' => 'views_view'],
    'views_view__wordpal_listing' => ['base hook' => 'views_view'],
    'views_view_unformatted__wordpal_query' => ['base hook' => 'views_view_unformatted'],
    'container__wordpal_query' => ['base hook' => 'container'],
    'container__wordpal_template' => ['base hook' => 'container'],
    'container__wordpal_listing' => ['base hook' => 'container'],
    // Views suggests pager__<tag> by itself; this name differs so a pager
    // rendered without wordpal_preprocess_views_view() keeps Drupal's pager.
    'pager__wordpal_query_settings' => ['base hook' => 'pager'],
  ];
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for block templates.
 */
function wordpal_theme_suggestions_block_alter(array &$suggestions, array $variables): void {
  $pluginId = $variables['plugin_id'] ?? $variables['elements']['#plugin_id'] ?? NULL;
  if (in_array($pluginId, [
    'wordpal_adjacent_post',
    'wordpal_comments',
    'wordpal_site_title',
    'wordpal_site_tagline',
    'wordpal_site_logo',
    'wordpal_navigation',
    'wordpal_navigation_link',
    'wordpal_categories',
    'wordpal_search',
    'wordpal_post_author_biography',
    'wordpal_latest_posts',
    'wordpal_latest_comments',
    'wordpal_page_list',
    'wordpal_tag_cloud',
    'wordpal_archives',
  ], TRUE)) {
    $suggestions[] = 'block__wordpal_runtime';
  }
  elseif (str_starts_with((string) $pluginId, 'views_block:')) {
    $viewId = explode('-', substr((string) $pluginId, strlen('views_block:')), 2)[0];
    $view = View::load($viewId);
    if ($view !== NULL && $view->get('tag') === ViewTags::QUERY && _wordpal_view_storage_has_query_settings($view)) {
      $suggestions[] = 'block__wordpal_runtime';
    }
    elseif ($view !== NULL && $view->get('tag') === ViewTags::LISTING) {
      $suggestions[] = 'block__views_block__wordpal_listing';
    }
  }
}

/**
 * Implements hook_theme_suggestions_views_view_alter().
 */
function wordpal_theme_suggestions_views_view_alter(array &$suggestions, array $variables): void {
  $tag = $variables['view']->storage->get('tag');
  if (($tag === ViewTags::QUERY || $tag === ViewTags::TEMPLATE) && !_wordpal_view_has_query_settings($variables['view'])) {
    return;
  }
  if ($tag === ViewTags::QUERY || $tag === ViewTags::TEMPLATE || $tag === ViewTags::LISTING) {
    $suggestions[] = "views_view__$tag";
  }
}

/**
 * Implements hook_theme_suggestions_views_view_unformatted_alter().
 */
function wordpal_theme_suggestions_views_view_unformatted_alter(array &$suggestions, array $variables): void {
  if ($variables['view']->storage->get('tag') === ViewTags::QUERY && _wordpal_view_has_query_settings($variables['view'])) {
    $suggestions[] = 'views_view_unformatted__wordpal_query';
  }
}

/**
 * Implements hook_theme_suggestions_container_alter().
 */
function wordpal_theme_suggestions_container_alter(array &$suggestions, array $variables): void {
  // A Template-tagged View's page display wraps its render element in a
  // themed container, always a <div>, one level above the Template's own
  // <main>; dropping the wrapper here lets that <main> stand alone.
  $pageViewId = $variables['element']['#view_id'] ?? NULL;
  $pageView = $pageViewId !== NULL ? \Drupal::entityTypeManager()->getStorage('view')->load($pageViewId) : NULL;
  if ($pageView !== NULL && $pageView->get('tag') === ViewTags::TEMPLATE) {
    $suggestions[] = 'container__wordpal_template';
    return;
  }
  // Embedded Views carry #view; page displays carry it on their build.
  $view = $variables['element']['#view'] ?? $variables['element']['view_build']['#view'] ?? NULL;
  if ($view === NULL) {
    return;
  }
  // A Listing View's views_block always wraps its render element the same
  // way; unlike Query, there is no third-party setting gate to check.
  if ($view->storage->get('tag') === ViewTags::LISTING) {
    $suggestions[] = 'container__wordpal_listing';
    return;
  }
  if (in_array($view->storage->get('tag'), [ViewTags::QUERY, ViewTags::TEMPLATE], TRUE) && _wordpal_view_has_query_settings($view)) {
    $suggestions[] = 'container__wordpal_query';
  }
}

/**
 * Implements hook_preprocess_links__wordpal_comment().
 *
 * Reuses core's own links preprocessing for the rendered link markup;
 * wrapper_attributes reaches the template as its own render array key
 * instead, set directly by CommentRuntime::renderActionLinks().
 */
function wordpal_preprocess_links__wordpal_comment(array &$variables): void {
  \Drupal::service(ThemePreprocess::class)->preprocessLinks($variables);
}

/**
 * Returns whether a View renders through wordpal's query runtime templates.
 *
 * The `wordpal.query` third-party setting marks a View that renders through
 * wordpal's query runtime templates; a View without it renders through its
 * own target.
 */
function _wordpal_view_has_query_settings(ViewExecutable $view): bool {
  return _wordpal_view_storage_has_query_settings($view->storage);
}

/**
 * Returns whether a View entity carries Canvas's `wordpal.query` setting.
 */
function _wordpal_view_storage_has_query_settings(ViewEntityInterface $view): bool {
  return $view->getThirdPartySetting('wordpal', 'query', NULL) !== NULL;
}

/**
 * Implements hook_preprocess_views_view().
 */
function wordpal_preprocess_views_view(array &$variables): void {
  if ($variables['view']->storage->get('tag') === ViewTags::LISTING) {
    $listing = ListingSettings::fromView($variables['view']->storage);
    $cacheability = CacheableMetadata::createFromRenderArray($variables);
    if ($listing->kind === 'page_list') {
      // The current page's item carries current-menu-item and aria-current.
      $cacheability->addCacheContexts(['route']);
    }
    $rows = \Drupal::service(ListingRows::class);
    $variables['listing'] = $listing;
    // comment() drops a row the viewer may not see beyond the View's own
    // published-status filters; the other kinds' rows are never NULL.
    $variables['items'] = array_values(array_filter(array_map(
      fn ($row): ?array => $rows->{$listing->method()}($row->_entity, $listing->settings, $cacheability),
      $variables['view']->result,
    )));
    $cacheability->applyTo($variables);
    return;
  }
  if ($variables['view']->storage->get('tag') !== ViewTags::QUERY || !_wordpal_view_has_query_settings($variables['view'])) {
    return;
  }
  $settings = QuerySettings::fromView($variables['view']->storage);
  $variables['query'] = $settings->query;
  $hasRows = $variables['view']->result !== [];
  $empty = $hasRows
    ? ['#markup' => '']
    : $variables['view']->display_handler->renderArea('empty', TRUE);
  $variables['wordpal_content'] = LayoutRenderer::build($settings->layout, [
    'rows' => $hasRows ? $variables['rows'] : ['#markup' => ''],
    'pager' => $hasRows ? $variables['pager'] : ['#markup' => ''],
    'empty' => $empty,
  ]);
}

/**
 * Implements hook_preprocess_views_view_unformatted().
 */
function wordpal_preprocess_views_view_unformatted(array &$variables): void {
  if ($variables['view']->storage->get('tag') !== ViewTags::QUERY || !_wordpal_view_has_query_settings($variables['view'])) {
    return;
  }
  $settings = QuerySettings::fromView($variables['view']->storage);
  $variables['post_template'] = $settings->postTemplate;
  $enhancedPagination = (bool) ($settings->query['enhanced_pagination'] ?? FALSE);
  $cacheability = CacheableMetadata::createFromRenderArray($variables);
  foreach ($variables['rows'] as $index => &$row) {
    $result = $variables['view']->result[$index];
    // A Search API View's rows carry their entity as a typed data object.
    $entity = $result->_entity ?? $result->_object->getValue();
    $row['wordpal_classes'] = PostClasses::for($entity, $settings, $cacheability);
    // render_block_core_post_template() keys each row for the Interactivity
    // API's client-side diffing only when the Query enables it.
    $row['wordpal_key'] = $enhancedPagination ? 'post-template-item-' . $entity->id() : NULL;
  }
  $cacheability->applyTo($variables);
}

/**
 * Implements hook_preprocess_pager().
 */
function wordpal_preprocess_pager(array &$variables): void {
  if (!isset($variables['pager']['#wordpal_settings'])) {
    return;
  }
  $variables['wordpal_settings'] = $variables['pager']['#wordpal_settings'];
  $variables['wordpal_pages'] = [];
  foreach ($variables['items']['pages'] ?? [] as $number => $page) {
    $variables['wordpal_pages'][] = ['url' => $page['href'], 'number' => $number];
  }
}
