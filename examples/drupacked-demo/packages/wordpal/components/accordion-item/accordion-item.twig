{#
/**
 * @file
 * WordPress core/accordion-item.
 *
 * wordpal_accordion_item() links the heading and the panel, as WordPress's
 * render callback does. A builder drop leaves open_by_default unset.
 */
#}
{% set item %}<div{{ attributes.addClass('wp-block-accordion-item', open_by_default ? 'is-open').merge(wordpal_attributes('core/accordion-item', _context)) }}>{% block content %}{% endblock %}</div>{% endset %}
{{ wordpal_accordion_item(item, open_by_default|default(false)) }}
