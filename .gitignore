# composer install --working-dir=examples/<site> writes these three, and
# application/vendor links to one of them for the PHP unit files. Mercury
# Demo's site recipe sits among the recipes Composer installs.
/examples/*/vendor/
/examples/*/web/
/examples/*/recipes/*
!/examples/mercury-demo/recipes/mercury_demo_site/
/application/vendor
/dist/
/dist-phase1/
/data/
/.phpunit.cache/
/application/.editorconfig
/application/.gitattributes
.superpowers/
.idea
__pycache__/
/test-results/
# gitlab-ci-local runs of ci/test/caller.gitlab-ci.yml
/.drupack/
/.gitlab-ci-local/
