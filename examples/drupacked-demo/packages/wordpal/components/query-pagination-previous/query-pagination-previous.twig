<a href="{{ wordpal_url(url) }}"{{ attributes.addClass('wp-block-query-pagination-previous').merge(wordpal_attributes('core/query-pagination-previous', _context, false)) }}>{% if pagination_arrow in ['arrow', 'chevron'] %}<span class="wp-block-query-pagination-previous-arrow is-arrow-{{ pagination_arrow }}" aria-hidden="true">{{ pagination_arrow == 'arrow' ? '←' : '«' }}</span>{% endif %}{{ label }}</a>
