{#
/**
 * @file
 * WordPress core/heading.
 */
#}
{% set safe_level = level in [1, 2, 3, 4, 5, 6] ? level : 2 %}
{% set tag = 'h' ~ safe_level %}
<{{ tag }}{{ attributes.addClass('wp-block-heading').merge(wordpal_attributes('core/heading', _context, false)) }}>{{ wordpal_html(content|default('')) }}</{{ tag }}>
{% if fit_text %}{{ attach_library('wordpal/interactivity.fit-text') }}{% endif %}
