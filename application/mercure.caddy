# The Mercure hub, protocol 1.0. Subscribers and HTTP publishers present an HS256 token
# signed with a secret that Site data or the engine's folder entry holds; iss and aud are
# the hub's address. PHP publishes through mercure_publish() with none. A browser's
# EventSource sends no Authorization header, so its token rides in a cookie. A site may
# serve plain http, where browsers drop the protocol's default __Secure- cookie name.
mercure {
	resource_identifier "{$DRUPACK_MERCURE_URL}"
	cookie_name mercure_access_token
	issuer "{$DRUPACK_MERCURE_URL}" {
		publisher {
			jwt "{$DRUPACK_MERCURE_PUBLISHER_SECRET}" HS256
		}
		subscriber {
			jwt "{$DRUPACK_MERCURE_SUBSCRIBER_SECRET}" HS256
		}
	}
	transport bolt {
		path "{$DRUPACK_RUNTIME_MERCURE_DB}"
		size 1000
	}
}
