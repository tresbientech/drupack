{
    "name": "tresbientech/drupack",
    "description": "Offline Drupal CMS with the Mercury Demo site template",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {"type": "composer", "url": "https://packages.drupal.org/8"},
        {
            "type": "package",
            "package": {
                "name": "drupal/wordpal",
                "version": "dev-main",
                "type": "drupal-module",
                "source": {
                    "type": "git",
                    "url": "/home/theodore/DEV/DRUPAL/wordpal",
                    "reference": "e8edd3a033efed9062d5ed1ab8e718df85e1249b"
                },
                "extra": {
                    "drupal-scaffold": {
                        "file-mapping": {
                            "[project-root]/recipes/wordpal/recipe.yml": "recipes/wordpal/recipe.yml",
                            "[project-root]/recipes/wordpal/config/core.entity_form_display.node.blog.default.yml": "recipes/wordpal/config/core.entity_form_display.node.blog.default.yml",
                            "[project-root]/recipes/wordpal/config/field.field.node.blog.field_content.yml": "recipes/wordpal/config/field.field.node.blog.field_content.yml",
                            "[project-root]/recipes/wordpal/config/field.field.node.blog.field_description.yml": "recipes/wordpal/config/field.field.node.blog.field_description.yml",
                            "[project-root]/recipes/wordpal/config/field.field.node.blog.field_featured_image.yml": "recipes/wordpal/config/field.field.node.blog.field_featured_image.yml",
                            "[project-root]/recipes/wordpal/config/field.field.node.blog.field_tags.yml": "recipes/wordpal/config/field.field.node.blog.field_tags.yml",
                            "[project-root]/recipes/wordpal/config/node.type.blog.yml": "recipes/wordpal/config/node.type.blog.yml"
                        }
                    }
                }
            }
        }
    ],
    "require": {
        "php": "~8.5.0",
        "ext-pdo_sqlite": "*",
        "composer/installers": "^2.3",
        "drupal/canvas": "1.12.0",
        "drupal/core-composer-scaffold": "^11.4",
        "drupal/core-project-message": "^11.4",
        "drupal/core-recommended": "^11.4",
        "drupal/core-vendor-hardening": "^11.4",
        "drupal/drupal_cms_content_type_base": "2.1.6",
        "drupal/drupal_cms_installer": "2.2.0",
        "drupal/drupal_cms_search": "2.2.0",
        "drupal/mcp_server": "^2.0@beta",
        "drupal/mcp_tools": "^1.0@beta",
        "drupal/mercury_demo": "1.1.0",
        "drupal/tool": "^1.0@dev",
        "drupal/wordpal": "dev-main",
        "drush/drush": "^13.6",
        "twig/twig": "3.29.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-vendor-hardening": true,
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "audit": {
            "ignore": {
                "PKSA-p9gd-j6gr-6f9t": "Affects Mcp\\Client\\Transport\\HttpTransport; drupal/mcp_tools and drupal/mcp_server use Mcp\\Server only."
            }
        },
        "platform": {"php": "8.5.10"},
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "drupal-scaffold": {
            "allowed-packages": ["drupal/wordpal"],
            "locations": {"web-root": "web/"},
            "file-mapping": {"[web-root]/example.gitignore": false}
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "web/modules/custom/{$name}": ["type:drupal-custom-module"],
            "web/themes/custom/{$name}": ["type:drupal-custom-theme"],
            "recipes/{$name}": ["type:drupal-recipe"]
        }
    }
}
