{#
/**
 * @file
 * WordPress core/spacer.
 */
#}
{% set extra = {} %}
{# The save function prints no height when the spacer fills or fits a flex parent. #}
{% if height and self_stretch not in ['fill', 'fit'] %}
  {% set extra = extra|merge({'height': wordpal_css_value(height)}) %}
{% endif %}
{% if width %}
  {% set extra = extra|merge({'width': wordpal_css_value(width)}) %}
{% endif %}
<div{{ attributes.addClass('wp-block-spacer').setAttribute('aria-hidden', 'true').merge(wordpal_attributes('core/spacer', _context, false, extra)) }}></div>
