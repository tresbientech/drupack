# Caddy splices each DRUPACK_RUNTIME environment reference into this text before it
# reads quotes, so a reference stays inside double quotes and a start refuses a value
# holding one.
{
	admin off
	persist_config off
	# The global half of the TLS source. The site block below names the other half.
	import "tls-{$DRUPACK_RUNTIME_TLS}-global.caddy"
	# Windows PHP keys its opcache segment per user account. The cache id gives each
	# served folder its own segment, as application/Caddyfile does per Site data.
	frankenphp {
		php_ini "opcache.cache_id" "{$DRUPACK_RUNTIME_ID}"
	}
	order php_server before file_server
	log {
		output stderr
		format console
		level ERROR
	}
}

(site) {
	bind "{$DRUPACK_RUNTIME_BIND}"
	root * "{$DRUPACK_RUNTIME_DOCROOT}"
	encode zstd br gzip

	# One route block keeps the written order, so every guard runs before Drupal.
	# Public files sit under the docroot, where the folder's settings put them, and
	# php_server serves them as static files.
	route {
		# The readiness probe runtime/watch/watch.go polls until this server answers, as in
		# application/Caddyfile. Placed ahead of the guards, which refuse any dot path.
		@drupackIdentity {
			path /.drupack-id
			query "id={$DRUPACK_RUNTIME_ID}"
		}
		respond @drupackIdentity 204
		@drupackIdentityOther path /.drupack-id
		respond @drupackIdentityOther 404

		import "guards.caddy"
		# mercure.caddy for a project whose composer.json sets extra.drupack.mercure, none.caddy
		# otherwise. The hub sits in php_server's route block, where FrankenPHP finds it.
		import "{$DRUPACK_RUNTIME_MERCURE_SNIPPET}"
		php_server {
			root "{$DRUPACK_RUNTIME_DOCROOT}"
		}
	}
}

# tls-none-site.caddy serves http on any address of the bind, tls-mkcert-site.caddy and
# tls-drupack-site.caddy https on the loopback names a local root covers.
import "tls-{$DRUPACK_RUNTIME_TLS}-site.caddy"
