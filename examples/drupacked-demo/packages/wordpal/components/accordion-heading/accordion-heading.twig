{#
/**
 * @file
 * WordPress core/accordion-heading.
 *
 * WordPress prints the padding on the button, and the letter spacing and
 * text decoration on the title.
 */
#}
{% set tag = 'h' ~ (level in [1, 2, 3, 4, 5, 6] ? level : 3) %}
{% set icon_side = show_icon ? icon_position|default('right') %}
{% set button_props = {'padding_top': padding_top, 'padding_right': padding_right, 'padding_bottom': padding_bottom, 'padding_left': padding_left} %}
{% set title_props = {'text_decoration': text_decoration, 'letter_spacing': letter_spacing} %}
{% set heading_props = _context|merge(button_props|map(v => null))|merge(title_props|map(v => null)) %}
{% set icon %}<span class="wp-block-accordion-heading__toggle-icon" aria-hidden="true">+</span>{% endset %}
<{{ tag }}{{ attributes.addClass('wp-block-accordion-heading', show_icon ? 'has-icon', icon_side ? 'has-icon-' ~ icon_side).merge(wordpal_attributes('core/accordion-heading', heading_props, false)) }}><button{{ wordpal_attributes('core/accordion-heading', button_props, false).addClass('wp-block-accordion-heading__toggle').setAttribute('type', 'button') }}>{% if icon_side == 'left' %}{{ icon }}{% endif %}<span{{ wordpal_attributes('core/accordion-heading', title_props, false).addClass('wp-block-accordion-heading__toggle-title') }}>{{ wordpal_html(title|default('')) }}</span>{% if icon_side == 'right' %}{{ icon }}{% endif %}</button></{{ tag }}>
