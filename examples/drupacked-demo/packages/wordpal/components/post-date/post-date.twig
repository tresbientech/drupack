{#- A saved `datetime` attribute is the block's own literal value
    (post-date.php prints it verbatim and skips the post-data source
    entirely); with none saved, the value comes from the post's own date,
    and post-data.php's "modified" source returns empty, so post-date.php
    then prints nothing, unless the post's saved content diverges from its
    published date: get_the_modified_date('U') > get_the_date('U'). A
    builder drop leaves timestamp null, and the block prints nothing. -#}
{% set literal = datetime is defined and datetime is not null %}
{% if literal or (timestamp is not null and not (published_timestamp is defined and published_timestamp is not null and timestamp <= published_timestamp)) %}
{% set printed_datetime = literal ? datetime : timestamp|date('c', 'UTC') %}
{% set formatted = wordpal_date(literal ? datetime|date('U') : timestamp, format|default(wordpal_default_date_format())) %}
<div{{ attributes.addClass('wp-block-post-date').merge(wordpal_attributes('core/post-date', _context, false)) }}>{% if is_link %}<a href="{{ wordpal_url(url) }}"><time datetime="{{ printed_datetime }}">{{ formatted }}</time></a>{% else %}<time datetime="{{ printed_datetime }}">{{ formatted }}</time>{% endif %}</div>
{%- endif %}
