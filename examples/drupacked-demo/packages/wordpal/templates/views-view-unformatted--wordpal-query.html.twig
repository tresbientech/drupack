{#
  Shared across targets, like views-view--wordpal-query.html.twig: only
  Canvas's writer fills `post_template` and each row's `wordpal_classes`.
  Display Builder's `ui_patterns` row plugin already builds each row's own
  markup, so its rows render with core's own unformatted-list default.
#}
{% if post_template is defined %}
  {% embed 'wordpal:post-template' with post_template %}
    {% block content %}
      {% for row in rows %}<li{% if row.wordpal_key %} data-wp-key="{{ row.wordpal_key }}"{% endif %} class="{{ row.wordpal_classes|join(' ') }}">{{ row.content }}</li>{% endfor %}
    {% endblock %}
  {% endembed %}
{% else %}
  {% for row in rows %}
    <div{{ row.attributes }}>
      {{- row.content -}}
    </div>
  {% endfor %}
{% endif %}
