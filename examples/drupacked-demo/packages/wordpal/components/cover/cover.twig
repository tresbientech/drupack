{#
/**
 * @file
 * WordPress core/cover.
 *
 * The outer element carries the colors and spacing, the inner container the
 * layout.
 */
#}
{# The editor saves a position class for every position but the center. #}
{% set explicit_ratio = aspect_ratio and aspect_ratio|trim|lower != 'auto' %}
{% set custom_position = content_position in ['top left', 'top center', 'top right', 'center left', 'center right', 'bottom left', 'bottom center', 'bottom right'] %}
{% set classes = [
  'wp-block-cover',
  is_dark is same as(false) ? 'is-light',
  has_parallax ? 'has-parallax',
  explicit_ratio ? 'has-aspect-ratio',
  is_repeated ? 'is-repeated',
  custom_position ? 'has-custom-content-position',
  custom_position ? 'is-position-' ~ content_position|replace({' ': '-'}),
] %}
{% set tag = tag_name in ['div', 'header', 'main', 'section', 'article', 'aside', 'footer', 'nav'] ? tag_name : 'div' %}
{# wp_render_dimensions_support() unsets the height under an explicit aspect
   ratio, and unsets the ratio when a cover states its height. #}
{% set extra = explicit_ratio
  ? {'aspect-ratio': wordpal_css_value(aspect_ratio), 'min-height': 'unset', 'height': 'unset'}
  : (min_height ? {'min-height': wordpal_css_value(min_height ~ (min_height_unit|default('px'))), 'aspect-ratio': 'unset'} : {}) %}
{# Cover's own gradient attribute is a preset slug; customGradient a raw CSS
   gradient. Neither belongs on the root: they overlay the background image.
   The save function keeps wp-block-cover__gradient-background for a saved
   image under a gradient and a dim. #}
{# dimRatioToClass() in the save function rounds the dim ratio to the
   nearest ten before it becomes a class. #}
{% set overlay = [
  'wp-block-cover__background',
  overlay_color ? 'has-' ~ overlay_color ~ '-background-color',
  'has-background-dim',
  dim_ratio is not null and dim_ratio != 50 ? 'has-background-dim-' ~ (10 * (dim_ratio / 10)|round),
  url and not use_featured_image and (gradient or custom_gradient) and dim_ratio is not same as(0) ? 'wp-block-cover__gradient-background',
  (gradient or custom_gradient) ? 'has-background-gradient',
  gradient ? 'has-' ~ gradient ~ '-gradient-background',
] %}
{% set overlay_style = {} %}
{% if custom_gradient and not gradient %}
  {% set overlay_style = overlay_style|merge({'background': wordpal_css_value(custom_gradient)}) %}
{% endif %}
{% if custom_overlay_color and not overlay_color %}
  {% set overlay_style = overlay_style|merge({'background-color': wordpal_css_value(custom_overlay_color)}) %}
{% endif %}
{% set overlay_span %}<span aria-hidden="true" class="{{ overlay|filter(v => v)|join(' ') }}"{% if overlay_style %} style="{{ wordpal_css_declarations(overlay_style) }}"{% endif %}></span>{% endset %}
{# The save function prints the image before the overlay, and cover.php
   inserts a featured image after it. #}
<{{ tag }}{{ attributes.addClass(classes).merge(wordpal_attributes('core/cover', _context|merge({'gradient': null, 'custom_gradient': null}), false, extra)) }}>
  {%- if use_featured_image %}{{ overlay_span }}{% endif -%}
  {%- if url -%}
    {%- if has_parallax or is_repeated -%}
      {#- The block's save() pairs role="img" with aria-label only when alt
          is set; cover.php never touches this div (useFeaturedImage is
          false here). -#}
      <div{% if alt %} role="img" aria-label="{{ alt }}"{% endif %} class="wp-block-cover__image-background{{ size_slug ? ' size-' ~ size_slug }}{{ has_parallax ? ' has-parallax' }}{{ is_repeated ? ' is-repeated' }}" style="{{ wordpal_css_declarations({'background-position': '50% 50%', 'background-image': wordpal_css_url(url)}) }}"></div>
    {%- else -%}
      {#- WordPress prints a featured image through get_the_post_thumbnail() (cover.php:152). -#}
      {%- if use_featured_image -%}
        <img{% if image_width %} width="{{ image_width }}"{% endif %}{% if image_height %} height="{{ image_height }}"{% endif %} class="wp-block-cover__image-background wp-post-image" alt="{{ alt|default('') }}" src="{{ wordpal_url(url) }}"{% if focal_point %} style="object-position:{{ wordpal_css_value(focal_point) }}"{% endif %} data-object-fit="cover"{% if focal_point %} data-object-position="{{ focal_point }}"{% endif %} decoding="async" loading="lazy" />
      {%- else -%}
        <img{% if in_template_part %} decoding="async"{% endif %} class="wp-block-cover__image-background{{ id ? ' wp-image-' ~ id }}{{ size_slug ? ' size-' ~ size_slug }}" alt="{{ alt|default('') }}" src="{{ wordpal_url(url) }}"{% if focal_point %} style="object-position:{{ wordpal_css_value(focal_point) }}"{% endif %} data-object-fit="cover"{% if focal_point %} data-object-position="{{ focal_point }}"{% endif %} />
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
  {%- if not use_featured_image %}{{ overlay_span }}{% endif -%}
  <div{{ wordpal_layout_attributes('core/cover', _context).addClass('wp-block-cover__inner-container') }}>{% block content %}{% endblock %}</div>
</{{ tag }}>{{ wordpal_duotone_filter(duotone) }}
