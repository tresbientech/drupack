{% if logo_url %}<div{{ attributes.addClass('wp-block-site-logo').merge(wordpal_attributes('core/site-logo', supports, false)) }}>{% if is_link %}<a href="{{ front_url }}" class="custom-logo-link" rel="home"{% if link_target == '_blank' %} target="_blank" aria-label="(Home link, opens in a new tab)"{% endif %}>{% endif %}<img src="{{ logo_url }}" class="custom-logo" alt="{{ alt }}"{% if width %} width="{{ width }}"{% endif %}>{% if is_link %}</a>{% endif %}</div>{% endif %}
