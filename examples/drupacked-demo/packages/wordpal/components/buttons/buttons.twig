{# A buttons block lays its children out in a row. #}
{% set layout_default = {'layout_type': 'flex'} %}
{# The save function marks any font size, preset or custom. #}
<div{{ attributes.addClass('wp-block-buttons').addClass(font_size ? 'has-custom-font-size').merge(wordpal_attributes('core/buttons', _context, true, {}, layout_default)) }}>{% block content %}{% endblock %}</div>
