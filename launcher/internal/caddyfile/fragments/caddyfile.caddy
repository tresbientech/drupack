{
	admin off
	persist_config off
{{include (print "tls-" .TLS.Source "-global") . | indent 1}}
	# Windows PHP keys its opcache segment per user account, so a second server attaches to
	# the first one's segment, finds opcode handlers from a differently based image and
	# aborts before it binds. The cache id gives each served state its own segment. Other
	# platforms do not register the directive and ignore it.
	frankenphp {
		php_ini "opcache.cache_id" {{quote .ID}}
	}
	order php_server before file_server
{{- if .TrustedProxies}}
	# client_ip and the access log take the client from a forwarded header these peers sent.
	servers {
		trusted_proxies static{{range .TrustedProxies}} {{.}}{{end}}
	}
{{- end}}
{{include (print .Mode "-log") . | indent 1}}
{{- if .ErrorLog}}
	# Caddy logs the access entry of a 5xx answer at ERROR, under an access logger.
	log errors {
{{include "log-file" .ErrorLog | indent 2}}
		level WARN
		exclude http.log.access
	}
{{- end}}
}

# Snippets are defined before their first import.
{{include "static.caddy" .}}

# One address per name the TLS source covers, so Caddy issues no certificate for a name
# a page asks for.
{{.Addresses .Bind .Port}} {
{{- with include (print "tls-" .TLS.Source "-site") .}}
{{indent 1 .}}
{{- end}}
	bind {{quote .Bind}}
	root * {{quote .Docroot}}
	encode zstd br gzip
{{- if .AccessLog}}
	# A named logger tags each line, and the static port's writes to the same file.
	log site {
{{include "log-file" .AccessLog | indent 2}}
	}
{{- end}}

	# One route block keeps the written order, so every guard runs before Drupal.
	route {
{{include "guards.caddy" . | indent 2}}
{{- if .ProjectRules}}
		# The project's own rules, after the guards.
		import {{quote .ProjectRules}}
{{- end}}
{{include (print .Mode "-files") . | indent 2}}
{{- if .Mercure}}
{{include "mercure.caddy" . | indent 2}}
{{- end}}
		php_server {
			root {{quote .Docroot}}
		}
	}
}
{{- with .OtherNames .Bind .Port "site"}}

{{include "other-names.caddy" .}}
{{- end}}
{{- if .Static}}

{{.Addresses .Static.Bind .Static.Port}} {
{{- with include (print "tls-" .TLS.Source "-site") .}}
{{indent 1 .}}
{{- end}}
{{include "static-site.caddy" . | indent 1}}
}
{{- with .OtherNames .Static.Bind .Static.Port "static"}}

{{include "other-names.caddy" .}}
{{- end}}
{{- end}}
