# Static-file snippets, imported at the top level of both Caddyfiles and applied under a
# matcher of the caller's: guards.caddy and engine/Caddyfile for the docroot,
# application/Caddyfile for the files directory.

# .htaccess 45. Caddy writes no Expires date.
(cachedForAYear) {
	header {args[0]} Cache-Control "max-age=31536000"
}
# .htaccess 153-192: a .br or .gz copy beside an aggregate.
(precompressedCopies) {
	file_server {args[0]} {
		precompressed br gzip
	}
}
# .htaccess 22-23. The mime table names .svgz image/svg+xml-compressed.
(svgzEncoding) {
	header {args[0]} {
		defer
		Content-Type image/svg+xml
		Content-Encoding gzip
	}
}
