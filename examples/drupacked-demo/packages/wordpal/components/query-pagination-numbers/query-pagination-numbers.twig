{# paginate_links() joins its links with a newline. #}
<div{{ attributes.addClass('wp-block-query-pagination-numbers').merge(wordpal_attributes('core/query-pagination-numbers', _context, false)) }}>{% if previous_ellipsis %}<span class="page-numbers dots">…</span>{{ "\n" }}{% endif %}{% for page in pages %}{% if not loop.first %}{{ "\n" }}{% endif %}{% if page.number == current %}<span aria-current="page" class="page-numbers current">{{ page.number }}</span>{% else %}<a class="page-numbers" href="{{ wordpal_url(page.url) }}">{{ page.number }}</a>{% endif %}{% endfor %}{% if next_ellipsis %}{{ "\n" }}<span class="page-numbers dots">…</span>{% endif %}</div>
