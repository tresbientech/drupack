{#
/**
 * @file
 * WordPress core/gallery.
 */
#}
{% set layout_default = {'layout_type': 'flex'} %}
{% set classes = [
  'wp-block-gallery',
  'has-nested-images',
  columns ? 'columns-' ~ columns : 'columns-default',
  image_crop ? 'is-cropped',
] %}
<figure{{ attributes.addClass(classes).merge(wordpal_attributes('core/gallery', _context, true, {}, layout_default)) }}>{% block content %}{% endblock %}{% if caption %}<figcaption class="blocks-gallery-caption wp-element-caption">{{ wordpal_html(caption) }}</figcaption>{% endif %}</figure>
