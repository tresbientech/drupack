# Caddy splices each DRUPACK_RUNTIME environment reference into this text before it
# reads quotes, so a reference stays inside double quotes and a start refuses a value
# holding one.
{
	admin off
	persist_config off
	# The global half of the TLS source. The site block below names the other half.
	import "tls-{$DRUPACK_RUNTIME_TLS}-global.caddy"
	# Windows PHP keys its opcache segment per user account, so a second server attaches to
	# the first one's segment, finds opcode handlers from a differently based image and aborts
	# before it binds. The cache id gives each Site data its own segment. Other platforms do
	# not register the directive and ignore it.
	frankenphp {
		php_ini "opcache.cache_id" "{$DRUPACK_RUNTIME_ID}"
	}
	order php_server before file_server
	log {
		output file "{$DRUPACK_RUNTIME_LOG_PATH}" {
			roll_size 100MiB
			roll_keep 10
		}
		format json
	}
}

# A snippet is defined before its first import.
import "static.caddy"

(site) {
	bind "{$DRUPACK_RUNTIME_BIND}"
	root * "{$DRUPACK_RUNTIME_DOCROOT}"
	encode zstd br gzip

	# Caddy sorts directives by kind, which puts a file route ahead of the matchers guarding it.
	# One route block keeps the written order.
	route {
		# The readiness probe runtime/watch/watch.go polls. The token names this Site data, and a
		# caller without it gets 404. Caddy answers without reaching Drupal. Placed ahead of the
		# protected-file matchers, which answer 403 for any dot path.
		@drupackIdentity {
			path /.drupack-id
			query "id={$DRUPACK_RUNTIME_ID}"
		}
		respond @drupackIdentity 204
		@drupackIdentityOther path /.drupack-id
		respond @drupackIdentityOther 404

		import "guards.caddy"
		# mercure.caddy for a site whose site.json sets mercure, none.caddy otherwise. The hub sits
		# in php_server's route block, where FrankenPHP finds it.
		import "{$DRUPACK_RUNTIME_MERCURE_SNIPPET}"
		# Public files live outside the application, which one release shares across sites. The
		# address stays root-relative, so it survives a restart on another port.
		route /sites/default/files/* {
			root * "{$DRUPACK_RUNTIME_FILES_DIR}"
			uri strip_prefix /sites/default/files
			# static.caddy, as guards.caddy applies it under the docroot.
			@stored file
			import cachedForAYear @stored
			@storedSvgz {
				file
				path *.svgz
			}
			import svgzEncoding @storedSvgz
			import precompressedCopies @stored
			# A missing file or a directory goes to the site with its query; a derivative exists
			# once generated.
			@absent not file
			rewrite @absent /sites/default/files{path}
		}
		php_server {
			root "{$DRUPACK_RUNTIME_DOCROOT}"
		}
	}
}

# tls-none-site.caddy serves http on any address of the bind, tls-mkcert-site.caddy and
# tls-drupack-site.caddy https on the loopback names a local root covers.
import "tls-{$DRUPACK_RUNTIME_TLS}-site.caddy"
