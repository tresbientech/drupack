<?php

/**
 * @file
 * Theme settings of the generated theme.
 */

use Drupal\Core\Extension\ThemeSettingsProvider;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_FORM_ID_alter() for system_theme_settings.
 */
function {theme}_form_system_theme_settings_alter(array &$form, FormStateInterface $form_state): void {
  $form['{setting}'] = [
    '#type' => 'select',
    '#title' => t('Style variation'),
    '#options' => \Drupal::service('extension.list.theme')->getExtensionInfo('{theme}')['wordpal_variations'],
    '#default_value' => \Drupal::service(ThemeSettingsProvider::class)->getSetting('{setting}', '{theme}'),
    '#weight' => -10,
  ];
}
