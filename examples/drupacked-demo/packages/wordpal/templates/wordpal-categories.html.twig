{% macro terms(items, show_count) %}{% for item in items %}<li class="cat-item cat-item-{{ item.id }}"><a href="{{ item.url }}">{{ item.name }}</a>{% if show_count %} ({{ item.count }}){% endif %}
{% if item.children %}<ul class="children">{{ _self.terms(item.children, show_count) }}</ul>{% endif %}</li>{% endfor %}{% endmacro %}
{% macro options(items, level) %}{% for item in items %}<option class="level-{{ level }}" value="{{ item.url }}">{{ item.name }}</option>
{% if item.children %}{{ _self.options(item.children, level + 1) }}{% endif %}{% endfor %}{% endmacro %}
{% if display_as_dropdown %}
{% set classes = ['wp-block-categories-dropdown', 'wp-block-categories-taxonomy-' ~ taxonomy, 'wp-block-categories'] %}
<div{{ attributes.addClass(classes).merge(wordpal_attributes('core/categories', supports, false)) }}><label class="wp-block-categories__label" for="{{ dropdown_id }}">{{ 'Categories'|t }}</label><select name="{{ taxonomy == 'post_tag' ? 'tag' : 'category_name' }}" id="{{ dropdown_id }}" class="postform">
<option value="-1">{{ 'Select Category'|t }}</option>
{{ _self.options(items, 0) }}</select><script>document.currentScript.previousElementSibling.addEventListener('change',function(e){if(e.target.value){window.location.assign(e.target.value);}});</script>
</div>
{% else %}
{% set classes = ['wp-block-categories-list', 'wp-block-categories-taxonomy-' ~ taxonomy, 'wp-block-categories'] %}<ul{{ attributes.addClass(classes).merge(wordpal_attributes('core/categories', supports, false)) }}>{{ _self.terms(items, show_count) }}</ul>
{% endif %}
