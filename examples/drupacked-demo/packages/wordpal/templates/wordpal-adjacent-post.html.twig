{% set previous = direction == 'previous' %}
{% set custom_label = label is not empty %}
{% set arrow_character = arrow == 'arrow' ? (previous ? '←' : '→') : (arrow == 'chevron' ? (previous ? '«' : '»') : '') %}
<div{{ create_attribute({'class': ['post-navigation-link-' ~ direction, 'wp-block-post-navigation-link']}).merge(wordpal_attributes('core/post-navigation-link', supports, false)) }}>{% if previous and arrow_character %}<span class="wp-block-post-navigation-link__arrow-previous is-arrow-{{ arrow }}" aria-hidden="true">{{ arrow_character }}</span>{% endif %}{% if show_title and custom_label and not link_label %}<span class="post-navigation-link__label">{{ label }}</span> {% endif %}<a href="{{ url }}" rel="{{ previous ? 'prev' : 'next' }}">{% if show_title %}{% if link_label %}<span class="post-navigation-link__label">{{ custom_label ? label : (previous ? 'Previous:' : 'Next:') }}</span> <span class="post-navigation-link__title">{{ title }}</span>{% else %}{{ title }}{% endif %}{% else %}{{ custom_label ? label : (previous ? 'Previous' : 'Next') }}{% endif %}</a>{% if not previous and arrow_character %}<span class="wp-block-post-navigation-link__arrow-next is-arrow-{{ arrow }}" aria-hidden="true">{{ arrow_character }}</span>{% endif %}</div>
