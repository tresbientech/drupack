{% set safe_level = level in [1, 2, 3, 4, 5, 6] ? level : 2 %}
{% set tag = 'h' ~ safe_level %}
<{{ tag }}{{ attributes.addClass('wp-block-post-title').merge(wordpal_attributes('core/post-title', _context, false)) }}>{% if is_link %}<a href="{{ wordpal_url(url) }}" target="_self">{{ title }}</a>{% else %}{{ title }}{% endif %}</{{ tag }}>
