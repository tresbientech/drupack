{#
/**
 * @file
 * WordPress core/social-links.
 */
#}
{% set layout_default = {'layout_type': 'flex'} %}
{% set classes = [
  'wp-block-social-links',
  size,
  show_labels ? 'has-visible-labels',
  icon_color_value ? 'has-icon-color',
  icon_background_color_value ? 'has-icon-background-color',
] %}
<ul{{ attributes.addClass(classes).merge(wordpal_attributes('core/social-links', _context, true, {}, layout_default)) }}>{% block content %}{% endblock %}</ul>
