{% if items %}
  {% embed 'wordpal:query-pagination' with wordpal_settings.pagination %}
    {% block content %}
      {% for child in wordpal_settings.pagination_order %}
        {% if child == 'previous' and items.previous %}{{ include('wordpal:query-pagination-previous', wordpal_settings.previous|merge({url: items.previous.href, pagination_arrow: wordpal_settings.pagination.pagination_arrow}), with_context = false) }}{% endif %}
        {% if child == 'numbers' %}{{ include('wordpal:query-pagination-numbers', wordpal_settings.numbers|merge({pages: wordpal_pages, current: current, previous_ellipsis: ellipses.previous|default(false), next_ellipsis: ellipses.next|default(false)}), with_context = false) }}{% endif %}
        {% if child == 'next' and items.next %}{{ include('wordpal:query-pagination-next', wordpal_settings.next|merge({url: items.next.href, pagination_arrow: wordpal_settings.pagination.pagination_arrow}), with_context = false) }}{% endif %}
      {% endfor %}
    {% endblock %}
  {% endembed %}
{% endif %}
