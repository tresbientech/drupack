{% set author = form.author.name|render %}
{% set email = form.author.mail|render %}
{% set homepage = form.author.homepage|render %}
<p class="comment-notes">{% if email %}<span id="email-notes">{{ 'Your email address will not be published.'|t }}</span> {% endif %}{% if form.comment_body.widget.0.value['#required'] or form.author.name['#required'] or form.author.mail['#required'] %}<span class="required-field-message">{{ 'Required fields are marked'|t }} <span class="required">*</span></span>{% endif %}</p>
<p class="comment-form-comment"><label for="{{ form.comment_body.widget.0.value['#id'] }}">{{ 'Comment'|t }}{% if form.comment_body.widget.0.value['#required'] %} <span class="required">*</span>{% endif %}</label> {{ form.comment_body.widget.0.value }}</p>
{% if author %}<p class="comment-form-author"><label for="{{ form.author.name['#id'] }}">{{ 'Name'|t }}{% if form.author.name['#required'] %} <span class="required">*</span>{% endif %}</label> {{ author }}</p>{% endif %}
{% if email %}<p class="comment-form-email"><label for="{{ form.author.mail['#id'] }}">{{ 'Email'|t }}{% if form.author.mail['#required'] %} <span class="required">*</span>{% endif %}</label> {{ email }}</p>{% endif %}
{% if homepage %}<p class="comment-form-url"><label for="{{ form.author.homepage['#id'] }}">{{ 'Website'|t }}</label> {{ homepage }}</p>{% endif %}
{{ form.author|without('name', 'mail', 'homepage') }}
{{ form|without('comment_body', 'author', 'actions') }}
<p class="form-submit wp-block-button">{{ form.actions.submit }}{{ form.actions|without('submit') }}</p>
