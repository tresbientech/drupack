# The Composer package drupal/drupack is this repository's archive, which
# holds these files alone.
/* export-ignore
/composer.json -export-ignore
/composer -export-ignore
/LICENSE -export-ignore

# Go tests compare these reference files byte for byte, so a Windows checkout
# keeps their LF endings.
/application/tests/site.json text eol=lf
/docs/cli.md text eol=lf
/launcher/internal/caddyfile/fragments/*.caddy text eol=lf
/launcher/internal/caddyfile/testdata/*.caddyfile text eol=lf

# gci reads a Go file with CRLF endings as unformatted, and build/go-tests.sh
# lints the Windows checkout too.
*.go text eol=lf
