{
    "name": "drupal/drupack",
    "description": "Installs drupack, which serves a Drupal project with its own PHP and web server, into the project root.",
    "type": "composer-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/tresbientech/drupack",
    "readme": "composer/README.md",
    "require": {
        "php": ">=8.1",
        "composer-plugin-api": "^2",
        "composer-runtime-api": "^2.2",
        "composer/semver": "^3"
    },
    "autoload": {
        "psr-4": {
            "Drupal\\Drupack\\Composer\\": "composer/"
        }
    },
    "extra": {
        "class": "Drupal\\Drupack\\Composer\\Plugin"
    },
    "bin": [
        "composer/drupack-install"
    ]
}
