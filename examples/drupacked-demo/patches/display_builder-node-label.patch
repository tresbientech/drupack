+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\display_builder\Kernel;
+
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+use Symfony\Component\Validator\ConstraintViolationListInterface;
+
+/**
+ * Tests the schema of a node's Display Builder settings.
+ *
+ * @internal
+ */
+#[Group('display_builder')]
+#[RunTestsInSeparateProcesses]
+final class SlotSourceLabelSchemaTest extends DisplayBuilderKernelTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'system',
+    'user',
+    'ui_patterns',
+    'ui_patterns_field',
+    'display_builder',
+  ];
+
+  /**
+   * A layout source holding a labelled node passes schema validation.
+   */
+  public function testLabelledNodeIsValid(): void {
+    self::assertCount(0, $this->validateRegionNodes([
+      [
+        'node_id' => 'node_1',
+        'source_id' => 'textfield',
+        'source' => ['value' => 'text'],
+        'third_party_settings' => ['display_builder' => ['label' => 'Hero']],
+      ],
+    ]));
+  }
+
+  /**
+   * A Display Builder setting the schema does not declare is rejected.
+   */
+  public function testUnknownSettingIsInvalid(): void {
+    self::assertCount(1, $this->validateRegionNodes([
+      [
+        'node_id' => 'node_1',
+        'source_id' => 'textfield',
+        'source' => ['value' => 'text'],
+        'third_party_settings' => ['display_builder' => ['title' => 'Hero']],
+      ],
+    ]));
+  }
+
+  /**
+   * Validates a layout source whose only region holds the given nodes.
+   *
+   * @param array $nodes
+   *   The nodes of the region.
+   *
+   * @return \Symfony\Component\Validator\ConstraintViolationListInterface
+   *   The violations.
+   */
+  private function validateRegionNodes(array $nodes): ConstraintViolationListInterface {
+    $data = [
+      'layout_id' => 'layout_onecol',
+      'settings' => [],
+      'regions' => ['content' => $nodes],
+    ];
+    $typed_config = $this->container->get('config.typed');
+    $definition = $typed_config->buildDataDefinition($typed_config->getDefinition('ui_patterns_source.layout'), $data);
+
+    return $typed_config->create($definition, $data)->validate();
+  }
+
+}
