{#
/**
 * @file
 * WordPress core/media-text.
 */
#}
{% set width = media_width ?? 50 %}
{% set right = media_position == 'right' %}
{% set classes = [
  'wp-block-media-text',
  right ? 'has-media-on-the-right',
  is_stacked_on_mobile ? 'is-stacked-on-mobile',
  vertical_alignment ? 'is-vertically-aligned-' ~ vertical_alignment,
  image_fill ? 'is-image-fill-element',
] %}
{% set grid = width != 50 ? {'grid-template-columns': right ? 'auto ' ~ width ~ '%' : width ~ '% auto'} : {} %}
{% set image_classes = [media_id and media_type == 'image' ? 'wp-image-' ~ media_id, media_id and media_type == 'image' ? 'size-' ~ (media_size_slug ?: 'full')] %}
{% set media %}
<figure class="wp-block-media-text__media">
  {%- if media_type == 'video' and media_url -%}
    <video controls src="{{ wordpal_url(media_url) }}"></video>
  {%- elseif media_url -%}
    {%- if href -%}<a{% if link_class %} class="{{ link_class }}"{% endif %} href="{{ wordpal_url(href) }}"{% if link_target %} target="{{ link_target }}"{% endif %}{% if rel %} rel="{{ rel }}"{% endif %}>{%- endif -%}
    <img{% if in_template_part %} decoding="async"{% endif %} src="{{ wordpal_url(media_url) }}" alt="{{ media_alt|default('') }}"{{ create_attribute({'class': image_classes|filter(c => c)}) }}/>
    {%- if href -%}</a>{%- endif -%}
  {%- endif -%}
</figure>
{% endset %}
{% set text %}<div class="wp-block-media-text__content">{% block content %}{% endblock %}</div>{% endset %}
<div{{ attributes.addClass(classes).merge(wordpal_attributes('core/media-text', _context, false, grid)) }}>{{ right ? text : media }}{{ right ? media : text }}</div>
