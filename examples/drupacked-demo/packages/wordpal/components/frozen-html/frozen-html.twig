{#
/**
 * @file
 * A Frozen block: the HTML WordPress rendered for a block with no component.
 *
 * Each Query inside the block left a hole in the HTML, which its slot fills.
 */
#}
{% for piece in wordpal_frozen_html(key, block_name) %}
  {{- piece -}}
  {%- if not loop.last %}{{ attribute(_context, 'hole_' ~ loop.index) }}{% endif -%}
{% endfor %}
