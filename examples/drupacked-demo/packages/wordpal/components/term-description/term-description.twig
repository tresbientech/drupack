{#
/**
 * @file
 * WordPress core/term-description.
 *
 * WordPress renders nothing outside a term page, or for a term with no
 * description.
 */
#}
{% set description = wordpal_term_description() %}
{% if description is not same as('') %}
<div{{ attributes.addClass('wp-block-term-description').merge(wordpal_attributes('core/term-description', _context, false)) }}>{{ description }}</div>
{% endif %}
