# composer install --working-dir=examples/<site> writes these three, and
# application/vendor links to one of them for the PHP unit files.
/examples/*/vendor/
/examples/*/web/
/examples/*/recipes/
/application/vendor
/dist/
/dist-phase1/
/data/
/.phpunit.cache/
/application/.editorconfig
/application/.gitattributes
.superpowers/
.idea
__pycache__/
/test-results/
