<?php

/**
 * @file
 * Theme generation hooks for WordPal Display Builder.
 */

declare(strict_types=1);

use Drupal\Component\Serialization\Yaml;
use Drupal\wordpal_convert\Theme\ThemeGenerator;
use Drupal\wordpal_display_builder\Theme\CssVariables;

/**
 * Implements hook_wordpal_theme_files_alter().
 *
 * Adds the theme's presets as a ui_skins CSS variables file, derived from
 * the design tokens file ThemeGenerator writes in the same pass: both ship
 * together, so the tokens file is always already in $files here.
 */
function wordpal_display_builder_wordpal_theme_files_alter(array &$files, string $themeId): void {
  $directory = ThemeGenerator::directory($themeId);
  $tokens = Yaml::decode($files[$directory . "$themeId.tokens.yml"]);
  $files[$directory . "$themeId.ui_skins.css_variables.yml"] = CssVariables::yaml($tokens);
}
