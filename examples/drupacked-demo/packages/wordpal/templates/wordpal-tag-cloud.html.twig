<p{{ attributes.addClass('wp-block-tag-cloud').merge(wordpal_attributes('core/tag-cloud', settings.supports, false)) }}>{% for tag in tags %}<a href="{{ tag.url }}" class="tag-cloud-link tag-link-{{ tag.id }} tag-link-position-{{ tag.position }}" style="font-size: {{ tag.size }};" aria-label="{{ tag.name }} ({{ tag.count }} {{ tag.count == 1 ? 'item'|t : 'items'|t }})">{{ tag.name }}{% if settings.show_tag_counts %}<span class="tag-link-count"> ({{ tag.count }})</span>{% endif %}</a>{{ loop.last ? '' : "\n" }}{% else %}{{ 'There’s no content to show here yet.'|t }}{% endfor %}</p>
