parameters:
    level: 0
    fileExtensions:
        - php
        - module
        - inc
        - install
        - theme
        - profile
    reportUnmatchedIgnoredErrors: false
    excludePaths:
        # WordPress core code, kept as it ships so it can be resynced.
        - js/script-modules
        - src/WordPress/StyleEngine/Vendor
        - modules/wordpal_convert/src/WordPress/WpBlockParser*.php
        # Scripts that run inside WordPress, where WP_* symbols exist.
        - modules/wordpal_convert/src/WordPress/playground
        - modules/wordpal_evaluate/src/playground
    scanFiles:
        # Excluded from analysis above, still read for the symbols they define.
        - src/WordPress/StyleEngine/Vendor/class-wp-style-engine.php
        - src/WordPress/StyleEngine/Vendor/class-wp-style-engine-css-declarations.php
        - modules/wordpal_convert/src/WordPress/playground/style-variations.php
        - modules/wordpal_convert/src/WordPress/playground/theme-files.php
    ignoreErrors:
        # Drupal plugins, forms and controllers construct themselves with new static().
        - "#^Unsafe usage of new static#"
        # Canvas adapter plugins extend its internal AdapterBase.
        -
            identifier: classExtendsInternalClass.classExtendsInternalClass
            path: modules/wordpal_canvas_runtime/src/Plugin/Adapter/EnsureArrayAdapter.php
