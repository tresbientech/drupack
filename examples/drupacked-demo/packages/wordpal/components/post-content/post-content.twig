{#
/**
 * @file
 * WordPress core/post-content.
 *
 * post-content.php prints nothing for empty content, and allows four tags.
 */
#}
{% set tag = tag_name|lower in ['div', 'main', 'section', 'article'] ? tag_name|lower : 'div' %}
{% set main = page_content|render %}
{% if content or main|trim %}<{{ tag }}{{ attributes.addClass('entry-content', 'wp-block-post-content').merge(wordpal_attributes('core/post-content', _context)) }}>{% if content %}{{ wordpal_post_content(content) }}{% endif %}{{ main }}</{{ tag }}>{% endif %}
